#!/usr/bin/env python3
"""タブ名の先頭にエージェントの状態グリフを出す常駐プロセス。

herdr にはタブごとに状態を出す設定が無く（0.9.0 時点。タブ用のメタデータ API も
無い）、ラベルを書き換えるしか手がない。tab.list は agent_status をタブ単位で
返すので、それをグリフに写してタブ名の先頭に足す。

herdr はタブ名を自動採番していて、タブを閉じると 1..n に詰め直す。リネームは
それを止めてしまうので、ラベルが単なる数字だったタブは「自動採番中」とみなし、
番号を表示順から計算し直す。数字以外のラベルは人が付けた名前なので温存する。

止め方:
    herdr-tab-glyphd --reset    グリフを剥がして番号を振り直し、常駐を終了
"""

import json
import os
import socket
import sys
import threading
import time

STATE = os.path.expanduser("~/.local/state/herdr")
PIDFILE = os.path.join(STATE, "tab-glyphd.pid")
SOCK = os.environ.get("HERDR_SOCK", os.path.expanduser("~/.config/herdr/herdr.sock"))

# 状態 → グリフ。色付きの絵文字を使うのは、herdr のタブバーが ANSI を
# 解釈せずエスケープ文字がそのまま見えてしまうため（実測で確認）。
# 絵文字なら文字自体が色を持つので、ラベルに色を載せる唯一の手になる。
# 色は herdr 標準のステータス表示に合わせる（blocked=赤 / done=緑 /
# working=青 / idle=灰）。絵文字は必ず全角2セルなので、選べるのは「セル内を
# どれだけ埋めるか」だけ。埋まりすぎる大きい丸も、埋まらなすぎる小さい菱形も
# 却下されたので、その中間の 🔷 を基準にしてある。
# ただし菱形には青と橙しか無く、赤と緑は同程度に埋まる丸で代用する。
# idle は最多（常時9タブ前後）なので、暗い背景に沈む ⚫ にして圧を抑える。
GLYPHS = {
    "blocked": "🔴",  # 入力待ち — 赤。菱形に赤が無いので丸
    "done": "🟢",     # 完了、未確認 — 緑。同上
    "working": "🔷",  # 実行中 — 大きい菱形の青
    "idle": "⚫",     # 待機 — 中くらいの黒丸。居ることだけ分かればいい
}
# 剥がす対象。過去に使っていた単色グリフも含める（切り替え前のタブが
# 残っていても素のラベルに戻せるように）。
# 過去に使った字種も剥がせるようにしておく（切り替え前のタブが残っていても
# --reset で素に戻せるように）。
ALL_GLYPHS = tuple(GLYPHS.values()) + (
    "🔵", "⚪", "🔹", "🔸", "🔶", "▪️", "▫️", "●", "✓", "◑", "·")

# 状態が変わるたびに全タブを引き直すと pane.updated の量に負ける。まとめて
# 間引く間隔。
COALESCE_SEC = 0.5


def call(method, params=None):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    try:
        s.sendall((json.dumps({"id": "tabglyph", "method": method,
                               "params": params or {}}) + "\n").encode())
        return json.loads(s.makefile("r").readline())
    finally:
        s.close()


# 長い順に見る。▪️ のように異体字セレクタ付きで2コードポイントあるグリフを
# 1文字だけ見て剥がそうとすると剥がし損ね、同期のたびに先頭へ積み重なる。
_STRIP = sorted(ALL_GLYPHS, key=len, reverse=True)


def base_label(label):
    """グリフを剥がした素のラベルを返す。積み重なっていても全部落とす。"""
    while True:
        for glyph in _STRIP:
            if label.startswith(glyph):
                label = label[len(glyph):].lstrip()
                break
        else:
            return label


def desired(label, index, status):
    """このタブに付けたいラベル。index は表示順(0始まり)。"""
    base = base_label(label)
    # 数字だけのラベル = herdr の自動採番。閉じたタブの分を詰めるため、
    # 保存された数字ではなく現在の表示順から作り直す。
    if base.isdigit():
        base = str(index + 1)
    glyph = GLYPHS.get(status)
    return "%s %s" % (glyph, base) if glyph else base


def each_tab():
    for w in call("workspace.list")["result"]["workspaces"]:
        r = call("tab.list", {"workspace_id": w["workspace_id"]})
        for i, t in enumerate(r["result"]["tabs"]):
            yield i, t


def sync(strip=False):
    """全タブのラベルを現在の状態に合わせる。strip=True ならグリフを剥がす。"""
    for i, t in each_tab():
        want = base_label(t["label"]) if strip else desired(
            t["label"], i, t.get("agent_status"))
        if strip and want.isdigit():
            want = str(i + 1)
        # 変化が無いときは投げない。投げると tab_renamed が返ってきて
        # 自分のイベントで自分が起きる無限ループになる。
        if want != t["label"]:
            call("tab.rename", {"tab_id": t["tab_id"], "label": want})


def claim_pidfile():
    os.makedirs(STATE, exist_ok=True)
    try:
        fd = os.open(PIDFILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    except OSError:
        try:
            with open(PIDFILE) as f:
                old = int(f.read().strip())
            os.kill(old, 0)
            return False
        except (OSError, ValueError):
            pass
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        return claim_pidfile()
    with os.fdopen(fd, "w") as f:
        f.write(str(os.getpid()))
    return True


def run_once(dirty):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    subs = [{"type": t} for t in (
        "tab.created", "tab.closed", "tab.renamed", "tab.moved",
        "pane.updated", "workspace.created", "workspace.closed")]
    s.sendall((json.dumps({"id": "tabglyph", "method": "events.subscribe",
                           "params": {"subscriptions": subs}}) + "\n").encode())
    for _ in s.makefile("r"):
        dirty.set()


def main():
    if "--reset" in sys.argv:
        try:
            with open(PIDFILE) as f:
                os.kill(int(f.read().strip()), 15)
                time.sleep(0.3)
        except (OSError, ValueError):
            pass
        sync(strip=True)
        print("グリフを剥がしました")
        return 0

    if not claim_pidfile():
        return 0

    dirty = threading.Event()

    def worker():
        while True:
            dirty.wait()
            dirty.clear()
            try:
                sync()
            except Exception:
                pass
            time.sleep(COALESCE_SEC)

    threading.Thread(target=worker, daemon=True).start()
    try:
        while True:
            dirty.set()          # 接続のたびに一度は全体を合わせる
            try:
                run_once(dirty)
            except Exception:
                pass
            time.sleep(3)        # サーバー再起動を待って張り直す
    finally:
        try:
            with open(PIDFILE) as f:
                if int(f.read().strip()) == os.getpid():
                    os.unlink(PIDFILE)
        except (OSError, ValueError):
            pass


if __name__ == "__main__":
    sys.exit(main())
