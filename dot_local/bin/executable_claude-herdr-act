#!/usr/bin/env python3
"""Claude Code のフックから、herdr のサイドバー agents 欄 2 行目に出す
「いま何をしているか」を pane トークンに報告する。種類ごとに別トークンにして
config.toml 側で記号と色を変える（1 種類だけ値を持ち、他は消す）。2 行に折り返す
ので <種類>1 / <種類>2 の 2 つずつ。

  UserPromptSubmit  : p = ❯ <投げた指示>          （実行中、まだツール前）
  PreToolUse        : t = ▸ <ツール> <対象>        （Edit config.toml など）
  PermissionRequest : q = ? <ツール> <対象>        （許可待ち）
  Notification      : q = ? <聞かれている内容>      （permission/elicitation）
  Stop / idle       : d = ✓ <最後に投げた指示>      （完了）
  SessionStart/End  : 全部消す

stdin にフックの JSON。herdr の外（HERDR_PANE_ID 無し）では何もしない。
最後の指示は Stop で使うのでセッションごとにファイルへ残す。
settings.json の hooks から呼ぶ（各イベント 1 プロセス、数 ms）。
"""

import json
import os
import socket
import sys
import unicodedata
from urllib.parse import urlparse

WIDTH = 34                        # 1 行の上限セル数（サイドバー幅 26 前後）
LINES = 2                         # 折り返す行数。config.toml の $p1/$p2 などと対応
KINDS = {"p": "❯ ", "t": "▸ ", "q": "? ", "d": "✓ "}   # 種類 → 行頭の記号
STATE = os.path.expanduser("~/.local/state/claude-herdr-act")
SOCK = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
SOURCE = "claude-hook"


def wrap(s, width=WIDTH, lines=LINES):
    """表示幅で LINES 行に折り返す。余れば最終行の末尾を … にする。"""
    s = " ".join(s.split())          # 改行・連続空白を 1 つに
    out, cur, w = [], "", 0
    for ch in s:
        cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if w + cw > width:
            out.append(cur)
            cur, w = "", 0
            if len(out) == lines:
                out[-1] = out[-1][:-1] + "…"
                break
        cur += ch
        w += cw
    else:
        out.append(cur)
    out = [x for x in out if x]
    return (out + [""] * lines)[:lines]


def report(pane_id, kind, text):
    """kind の <kind>1/<kind>2 に記号付きで折り返した text を入れ、他の種類は消す。
    kind が None なら全部消す。"""
    tokens = {k + str(i): None for k in KINDS for i in (1, 2)}
    if kind and text:
        l1, l2 = wrap(KINDS[kind] + text)
        tokens[kind + "1"], tokens[kind + "2"] = l1 or None, l2 or None
    msg = {"id": "act", "method": "pane.report_metadata",
           "params": {"pane_id": pane_id, "source": SOURCE, "tokens": tokens}}
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps(msg) + "\n").encode())
        s.makefile("r").readline()
    finally:
        s.close()


def tool_line(name, inp):
    inp = inp or {}
    base = lambda k: os.path.basename(str(inp.get(k) or "")).rstrip("/")
    if name.startswith("mcp__"):
        parts = name.split("__")
        return " ".join(parts[1:3])
    if name in ("Edit", "Write", "Read", "NotebookEdit"):
        arg = base("file_path") or base("notebook_path")
    elif name == "Bash":
        arg = inp.get("description") or str(inp.get("command") or "").split("\n")[0]
    elif name in ("Grep", "Glob"):
        arg = inp.get("pattern") or ""
    elif name in ("Agent", "Task"):
        arg = inp.get("description") or ""
    elif name == "WebFetch":
        arg = urlparse(str(inp.get("url") or "")).netloc
    elif name == "WebSearch":
        arg = inp.get("query") or ""
    elif name == "Skill":
        arg = inp.get("skill") or ""
    else:
        arg = ""
    return (name + " " + str(arg)).strip()


def prompt_path(session_id):
    return os.path.join(STATE, session_id or "unknown")


def save_prompt(session_id, prompt):
    os.makedirs(STATE, exist_ok=True)
    with open(prompt_path(session_id), "w") as f:
        f.write(prompt)


def load_prompt(session_id):
    try:
        with open(prompt_path(session_id)) as f:
            return f.read()
    except OSError:
        return ""


def main():
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        return 0
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return 0
    event = ev.get("hook_event_name") or ""
    sid = ev.get("session_id") or ""
    kind, text = None, ""            # kind None + text "" = 全部消す

    if event == "UserPromptSubmit":
        text = " ".join((ev.get("prompt") or "").split())[:300]
        save_prompt(sid, text)
        kind = "p"
    elif event == "PreToolUse":
        kind, text = "t", tool_line(ev.get("tool_name") or "", ev.get("tool_input"))
    elif event == "PermissionRequest":
        kind, text = "q", tool_line(ev.get("tool_name") or "", ev.get("tool_input"))
    elif event == "Notification":
        nt = ev.get("notification_type") or ""
        if nt == "idle_prompt":
            kind, text = "d", load_prompt(sid)
        elif nt in ("permission_prompt", "elicitation_dialog"):
            kind, text = "q", ev.get("message") or nt
        else:
            return 0
    elif event == "Stop":
        kind, text = "d", load_prompt(sid)
    elif event == "SessionStart":
        pass
    elif event == "SessionEnd":
        try:
            os.remove(prompt_path(sid))
        except OSError:
            pass
    else:
        return 0

    try:
        report(pane_id, kind, text)
    except OSError:
        pass                         # herdr が居ない/落ちている: フックは失敗させない
    return 0


if __name__ == "__main__":
    sys.exit(main())
