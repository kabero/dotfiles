#!/usr/bin/env python3
"""Claude Code のフックから、herdr のサイドバー agents 欄 2 行目に出す
「いま何をしているか」を pane トークン $act に報告する。

  UserPromptSubmit  : › <投げた指示>            （実行中、まだツール前）
  PreToolUse        : <ツール> <対象>            （Edit config.toml など）
  PermissionRequest : ? <ツール> <対象>          （許可待ち）
  Notification      : ? <聞かれている内容>        （permission/elicitation）
  Stop / idle       : <最後に投げた指示>          （完了。状態の色は herdr が出す）
  SessionStart/End  : トークンを消す

stdin にフックの JSON。herdr の外（HERDR_PANE_ID 無し）では何もしない。
最後の指示は Stop で使うのでセッションごとにファイルへ残す。
settings.json の hooks から呼ぶ（各イベント 1 プロセス、数 ms）。
"""

import json
import os
import socket
import sys
import unicodedata
from urllib.parse import urlparse

WIDTH = 34                        # サイドバー幅 26 前後 + 折り返し無し前提の上限
STATE = os.path.expanduser("~/.local/state/claude-herdr-act")
SOCK = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
SOURCE = "claude-hook"


def clip(s, width=WIDTH):
    s = " ".join(s.split())          # 改行・連続空白を 1 つに
    out, w = "", 0
    for ch in s:
        cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if w + cw > width - 1:
            return out + "…"
        out += ch
        w += cw
    return out


def report(pane_id, value):
    msg = {"id": "act", "method": "pane.report_metadata",
           "params": {"pane_id": pane_id, "source": SOURCE, "tokens": {"act": value}}}
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps(msg) + "\n").encode())
        s.makefile("r").readline()
    finally:
        s.close()


def tool_line(name, inp):
    inp = inp or {}
    base = lambda k: os.path.basename(str(inp.get(k) or "")).rstrip("/")
    if name.startswith("mcp__"):
        parts = name.split("__")
        return " ".join(parts[1:3])
    if name in ("Edit", "Write", "Read", "NotebookEdit"):
        arg = base("file_path") or base("notebook_path")
    elif name == "Bash":
        arg = inp.get("description") or str(inp.get("command") or "").split("\n")[0]
    elif name in ("Grep", "Glob"):
        arg = inp.get("pattern") or ""
    elif name in ("Agent", "Task"):
        arg = inp.get("description") or ""
    elif name == "WebFetch":
        arg = urlparse(str(inp.get("url") or "")).netloc
    elif name == "WebSearch":
        arg = inp.get("query") or ""
    elif name == "Skill":
        arg = inp.get("skill") or ""
    else:
        arg = ""
    return (name + " " + str(arg)).strip()


def prompt_path(session_id):
    return os.path.join(STATE, session_id or "unknown")


def save_prompt(session_id, prompt):
    os.makedirs(STATE, exist_ok=True)
    with open(prompt_path(session_id), "w") as f:
        f.write(prompt)


def load_prompt(session_id):
    try:
        with open(prompt_path(session_id)) as f:
            return f.read()
    except OSError:
        return ""


def main():
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        return 0
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return 0
    kind = ev.get("hook_event_name") or ""
    sid = ev.get("session_id") or ""
    value = None                     # None = 変更なし、"" = 消す

    if kind == "UserPromptSubmit":
        p = clip(ev.get("prompt") or "")
        save_prompt(sid, p)
        value = "› " + p if p else ""
    elif kind == "PreToolUse":
        value = clip(tool_line(ev.get("tool_name") or "", ev.get("tool_input")))
    elif kind == "PermissionRequest":
        value = clip("? " + tool_line(ev.get("tool_name") or "", ev.get("tool_input")))
    elif kind == "Notification":
        nt = ev.get("notification_type") or ""
        if nt == "idle_prompt":
            value = load_prompt(sid)
        elif nt in ("permission_prompt", "elicitation_dialog"):
            value = clip("? " + (ev.get("message") or nt))
    elif kind == "Stop":
        value = load_prompt(sid)
    elif kind == "SessionStart":
        value = ""
    elif kind == "SessionEnd":
        value = ""
        try:
            os.remove(prompt_path(sid))
        except OSError:
            pass

    if value is None:
        return 0
    try:
        report(pane_id, value or None)
    except OSError:
        pass                         # herdr が居ない/落ちている: フックは失敗させない
    return 0


if __name__ == "__main__":
    sys.exit(main())
