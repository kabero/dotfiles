#!/usr/bin/env python3
"""新しいタブを、末尾ではなく現在のタブのすぐ右隣に作る。

herdr の組み込み new_tab は必ず末尾に足す。挿入位置の設定項目は無いが、
API の tab.move が insert_index を取るので「作ってから隣へ動かす」で実現できる
（tab move は CLI に露出していないのでソケットを直接叩く）。

prefix+c に [[keys.command]] type = "shell" で割り当ててある。組み込みの
new_tab は prefix+shift+c へ退避してあるので、末尾に足したいときはそちら。

cwd は指定しない: herdr の new_cwd ポリシー（既定 "follow" = 元のペインを
継承）にそのまま従わせ、組み込みと同じ挙動にするため。
"""

import json
import os
import socket
import sys

SOCK = os.environ.get("HERDR_SOCK", os.path.expanduser("~/.config/herdr/herdr.sock"))


def call(method, params=None):
    """1接続1リクエスト。"""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    try:
        s.sendall((json.dumps({"id": "newtab", "method": method,
                               "params": params or {}}) + "\n").encode())
        return json.loads(s.makefile("r").readline())
    finally:
        s.close()


def die(msg):
    print("herdr-new-tab: %s" % msg, file=sys.stderr)
    raise SystemExit(1)


def main():
    # 呼び出し元の文脈は環境に入らない起動経路があるので、フォーカス中の
    # ワークスペースとタブを API から引く。
    ws = None
    for w in call("workspace.list")["result"]["workspaces"]:
        if w.get("focused"):
            ws = w["workspace_id"]
            break
    if ws is None:
        ws = os.environ.get("HERDR_WORKSPACE_ID") or die("フォーカス中のワークスペースが不明")

    tabs = call("tab.list", {"workspace_id": ws})["result"]["tabs"]
    # tab.list は表示順で返る。現在のタブの次が挿入先。
    index = next((i for i, t in enumerate(tabs) if t.get("focused")), len(tabs) - 1)

    r = call("tab.create", {"workspace_id": ws, "focus": True})
    if "error" in r:
        die("tab.create: %s" % r["error"])
    tab_id = r["result"]["tab"]["tab_id"]

    m = call("tab.move", {"tab_id": tab_id, "insert_index": index + 1})
    if "error" in m:
        die("tab.move: %s" % m["error"])

    # move がフォーカスを持っていかない場合に備えて明示的に寄せる。
    call("tab.focus", {"tab_id": tab_id})


if __name__ == "__main__":
    main()
