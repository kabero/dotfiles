#!/bin/bash
# 「入力したペイン」だけを並べた MRU ピッカー — herdr-repo-selector のペイン版。
#
# Enter は移動ではなく「寄り道」: 選んだペインの端末をこの popup の中に
# attach する（herdr-pane-attach = 同じ端末を別の場所に出す、シンボリック
# リンク的なもの）。popup が開いている = 寄り道中、もう一度 prefix+m
# （C-q m）で detach すると popup が閉じて元の場所に戻る。周りには元の層が
# 見えたまま。herdr 純正の `terminal attach` は detach が ctrl+b q 固定なので、
# terminal session control で自前に組んだクライアントを使う。
# attach 中は元のペインの端末サイズが popup のサイズになり、detach で戻る
# （observe と違い、書き込み可能な attach はサイズも持つ）。
# 本当に移動したい時は ctrl-o（従来のフォーカス移動）。
# herdr の popup は 1 枚しか出せない（singleton、モーダル中は ui_busy）ので
# 寄り道は 1 段まで。
# フォーカスしただけ、ログを眺めただけのペインは載らない。載るのは
#   シェル      : コマンドを実行した (zsh preexec、dot_zshrc の HERDR ブロック)
#   エージェント: プロンプトを投げた (プラグイン kabe.pane-history が
#                 pane.agent_status_changed フックで working 遷移を検知)
# の2つだけ。prefix+m に [[keys.command]] で割り当ててある。
#
# 履歴は追記のみの ~/.local/state/herdr/pane-history.tsv:
#   <epoch>\t<pane_id>\t<shell|agent>\t<detail>
# ラベルやエージェント状態は保存せず、表示のたびに API から引き直す
# （閉じたペインが消え、リネームや状態変化が常に最新になる）。
# 依存: fzf, jq, python3（フォーカスだけ socket API を直接叩くため）。
#
# 表示は「何をしているペインか」が分かる形にする:
#   エージェント: Claude が付ける端末タイトル（terminal_title_stripped、作業の要約）
#   シェル      : cwd（~ 省略）と最後のコマンド

set -u
hist="$HOME/.local/state/herdr/pane-history.tsv"
# これより古い入力は載せない。寄り道のスタックは「作業内容がまだ頭に残って
# いるペイン」の一覧であって全履歴ではない。一晩空けば空になる程度の長さ。
MAX_AGE=${HPH_MAX_AGE:-$((8 * 3600))}
# 色。端末は Kanagawa Dragon（背景 #181616）で fzf は端末の背景をそのまま使う
# ので、同じパレットの暖色系の黒で揃える（無彩色の 23x 系は色味が浮く）。
CURSOR_BG="#393836"           # カーソル行 (dragonBlack5)
# 名前欄の背景はスペースごとの色（herdr-space-color、サイドバーの agents 欄の
# スペース名と同じハッシュ・同じ色相）。同じスペースのペインが縦に揃って見える。
SPACE_COLOR=~/.local/bin/herdr-space-color
[ -s "$hist" ] || { echo "履歴がまだありません" >&2; sleep 1; exit 0; }

# 生きているペイン一覧。label は herdr が出す表示名（"repo · claude" など）。
# 末尾にスペース名（workspace のラベル）を付ける: 色の元。
wsmap=$(herdr workspace list 2>/dev/null | jq -c '
  [.result.workspaces[] | {key: .workspace_id, value: (.label // "")}] | from_entries') || exit 1
panes=$(herdr pane list 2>/dev/null | jq -r --argjson ws "$wsmap" '
  .result.panes[] | [.pane_id, (.label // ""), (.agent // ""), .agent_status,
                     (if .focused then "1" else "0" end),
                     (.terminal_title_stripped // ""), (.cwd // ""),
                     (.agent_session.value // ""),
                     ($ws[.workspace_id] // "")] | @tsv') || exit 1
[ -n "$panes" ] || exit 0

# pane 一覧 → 履歴 の順に awk へ流し、ペインごとの最新の1件だけを残す。
# 閉じたペインと、いま自分がいるペインは落とす（自分は寄り道の行き先に
# ならない）。残りは MRU。
# ペイン一覧は環境変数で渡す: awk の -v は改行を含む値を受け取れない（BSD awk は
# "newline in string" で落ちる）。herdr-repo-selector と同じ回避。
# 自分の判定: popup には HERDR_ACTIVE_PANE_ID（下にあるペイン）が渡り、
# HERDR_PANE_ID は空。直接起動したときは HERDR_PANE_ID。API の focused も併用。
rows=$(HPH_PANES="$panes" HPH_SELF="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}" \
  awk -F'\t' -v now="$(date +%s)" -v max_age="$MAX_AGE" '
  BEGIN {
    self = ENVIRON["HPH_SELF"]
    n = split(ENVIRON["HPH_PANES"], lines, "\n")
    for (i = 1; i <= n; i++) {
      if (lines[i] == "") continue
      split(lines[i], f, "\t")
      label[f[1]] = f[2]; agent[f[1]] = f[3]; status[f[1]] = f[4]
      title[f[1]] = f[6]; cwd[f[1]] = f[7]; sess[f[1]] = f[8]; space[f[1]] = f[9]
      if (f[5] == "1") current = f[1]
      alive[f[1]] = 1
    }
  }
  NF >= 3 && ($2 in alive) {
    ts[$2] = $1; kind[$2] = $3; detail[$2] = $4    # 後勝ち = 最新
  }
  END { for (p in ts) {
          if (p == current || p == self) continue
          if (now - ts[p] > max_age) continue
          printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
            ts[p], p, kind[p], detail[p], label[p], agent[p], status[p],
            0, title[p], cwd[p], sess[p], space[p] } }
' "$hist" | sort -t$'\t' -k1,1rn)

[ -n "$rows" ] || { echo "飛べるペインがありません" >&2; sleep 1; exit 0; }

# セッションの長さ（作られてからの時間）。pane_id \t 開始 epoch。
#   エージェント: agent_session の ID から Claude Code のセッションファイル
#                 (~/.claude/projects/*/<id>.jsonl) を引き、その作成時刻。
#                 claude -r で再開しても元の会話の開始時刻になる。
#   それ以外    : pane process-info のシェル PID の起動時刻（= ペイン作成）。
# 一覧に載るペインの分だけ引く（process-info は 1 回 7ms 程度）。
starts=$(while IFS=$'\t' read -r _ pid _ _ _ agent _ _ _ _ sess; do
  start=""
  if [ -n "$agent" ] && [ -n "$sess" ]; then
    for f in "$HOME"/.claude/projects/*/"$sess".jsonl; do
      [ -e "$f" ] && start=$(stat -f %B "$f" 2>/dev/null) && break
    done
  fi
  if [ -z "$start" ]; then
    spid=$(herdr pane process-info --pane "$pid" 2>/dev/null | jq -r '.result.process_info.shell_pid // empty')
    if [ -n "$spid" ]; then
      # etime は [[dd-]hh:]mm:ss
      start=$(ps -o etime= -p "$spid" 2>/dev/null | awk -v now="$(date +%s)" '{
        days = 0; t = $1
        if (t ~ /-/) { split(t, d, "-"); days = d[1]; t = d[2] }
        n = split(t, a, ":"); s = 0
        for (i = 1; i <= n; i++) s = s * 60 + a[i]
        print now - (days * 86400 + s) }')
    fi
  fi
  printf "%s\t%s\n" "$pid" "$start"
done <<< "$rows")

# スペース名 → 背景色（"r;g;b"）。一覧に出るスペースの分だけ、1 回の呼び出しで
# まとめて引く。16進は bash の printf で 10進に直す（BSD awk に strtonum が無い）。
spaces=()
while IFS= read -r sp; do [ -n "$sp" ] && spaces+=("$sp"); done < <(cut -f12 <<< "$rows" | sort -u)
colors=""
if [ ${#spaces[@]} -gt 0 ] && [ -x "$SPACE_COLOR" ]; then
  colors=$(while IFS=$'\t' read -r _ _ bg sp; do
    printf "%s\t%d;%d;%d\n" "$sp" "0x${bg:1:2}" "0x${bg:3:2}" "0x${bg:5:2}"
  done < <("$SPACE_COLOR" "${spaces[@]}"))
fi

# 表示行を組み立てる。エージェント状態は先頭のドットの色で示す
# （blocked=入力待ち、done=未確認の完了、working=実行中、idle=待機）。
# 文字で補わず色と明暗で見せる方針: 語やアイコンを足すと読む手間が増える。
list=$(HPH_STARTS="$starts" HPH_COLORS="$colors" awk -F'\t' -v now="$(date +%s)" -v home="$HOME" '
  BEGIN {
    n = split(ENVIRON["HPH_STARTS"], lines, "\n")
    for (i = 1; i <= n; i++) { split(lines[i], f, "\t"); if (f[2] != "") start[f[1]] = f[2] }
    n = split(ENVIRON["HPH_COLORS"], lines, "\n")
    for (i = 1; i <= n; i++) { split(lines[i], f, "\t"); if (f[2] != "") bg[f[1]] = "\033[48;2;" f[2] "m" }
  }
  function ago(s,   d) {
    d = now - s
    if (d < 60)    return int(d) "s"
    if (d < 3600)  return int(d / 60) "m"
    if (d < 86400) return int(d / 3600) "h"
    return int(d / 86400) "d"
  }
  {
    st = $7
    if (st == "blocked")      dot = "\033[38;5;203m●"
    else if (st == "done")    dot = "\033[38;5;114m●"
    else if (st == "working") dot = "\033[38;5;75m●"
    else if (st == "idle")    dot = "\033[38;5;245m●"
    else                      dot = "\033[38;5;238m·"
    # 名前欄（ドット〜ラベル）の背景をスペースの色で塗る。欄の中で色を戻す
    # ときは背景を保ったまま戻す（R）。fzf はカーソル行でも項目側の背景を
    # 優先するので、カーソルは残りの欄の bg+ とポインタで分かる。
    bgc = ($12 in bg) ? bg[$12] : ""
    R = "\033[0m" bgc
    # ラベル "repo · agent" は repo を明るく、エージェント名を薄く。
    repo = $5; rest = ""; suffix = " · " $6
    if ($6 != "" && substr($5, length($5) - length(suffix) + 1) == suffix) {
      repo = substr($5, 1, length($5) - length(suffix))
      rest = suffix
    }
    # 「いま何をしているペインか」は履歴の種類（shell/agent）ではなく現在の
    # 状態で決める。履歴の最後が "$ claude" のシェル入力でも、いまエージェントが
    # 動いていればそちら。エージェントは端末タイトル（Claude の作業要約）、
    # 無ければ状態表示。シェルは cwd を主にして、最後のコマンドは薄く添える
    # （"ls" "cd .." が大半で、それ単体では場所が分からない）。
    if ($6 != "") {
      detail = ($9 != "") ? $9 : "[" $6 "] " st
    } else {
      dir = $10
      if (dir == home) dir = "~"
      else if (index(dir, home "/") == 1) dir = "~" substr(dir, length(home) + 1)
      if (length(dir) > 40) dir = "…" substr(dir, length(dir) - 38)
      detail = dir "  \033[38;5;243m$ " $4
    }
    age = now - $1
    # 時間的な距離はバーの長さで示す。最近ほど長く、対数的に縮む
    # （5分以内=5, 30分=4, 2時間=3, 4時間=2, それ以上=1）。ago の数字より
    # 先に目に入る。
    if (age < 300)         seg = 5
    else if (age < 1800)   seg = 4
    else if (age < 7200)   seg = 3
    else if (age < 14400)  seg = 2
    else                   seg = 1
    bar = ""
    for (i = 1; i <= 5; i++) bar = bar ((i <= seg) ? "━" : "\033[38;5;236m━\033[0m")
    # 鮮度は色で示す: 1時間以内は白、それより古いものは段階的に落とす。
    if (age < 3600)        { name = "\033[1;38;5;255m"; text = "\033[38;5;250m"; barc = "\033[38;5;75m" }
    else if (age < 4*3600) { name = "\033[38;5;252m";   text = "\033[38;5;246m"; barc = "\033[38;5;67m" }
    else                   { name = "\033[38;5;246m";   text = "\033[38;5;241m"; barc = "\033[38;5;60m" }
    bar = barc bar "\033[0m"
    # awk の length() はバイト単位。中黒は 2バイト1桁なので、継続バイト数を
    # 引いて表示幅で詰める。
    tmp = repo rest
    pad = 26 - (length(tmp) - gsub(/[\200-\277]/, "", tmp))
    # セッションの長さ。経過時間（最後の入力からの時間）と区別できるよう
    # 一段暗く、幅を揃えて置く。取れなければ空欄。
    life = ($2 in start) ? ago(start[$2]) : ""
    row = sprintf("%s %s%s  %s%s%s\033[38;5;243m%s%*s \033[0m %s \033[38;5;243m%-4s\033[0m \033[38;5;240m%-4s\033[0m %s%.90s\033[0m",
                  bgc, dot, R, name, repo, R, rest, (pad > 0 ? pad : 0), "", bar, ago($1), life, text, detail)
    printf "%s\t%s\n", row, $2
  }
' <<< "$rows")

# fzf は既定で ctrl-q を abort に割り当てているので、prefix (C-q) を押した
# だけでピッカーが閉じてしまう。寄り道と同じく「C-q m で閉じる」に揃える:
# C-q で m に abort を動的に割り当て、クエリが変わったら解除する。
# C-q 単独では何も起きない。Esc は従来どおり閉じる。
selected=$(fzf --ansi --height 100% --layout reverse \
      --border rounded --border-label " panes (herdr) " \
      --color "fg:-1,bg:-1,fg+:255,bg+:$CURSOR_BG,hl:75,hl+:75,pointer:75,marker:75,border:238,label:75,prompt:75,info:243,header:243,gutter:-1,spinner:75" \
      --pointer "▌" --prompt "> " \
      --delimiter='\t' --with-nth=1 --highlight-line \
      --expect=ctrl-o \
      --bind 'ctrl-q:rebind(m)' --bind 'm:abort' --bind 'start:unbind(m)' \
      --bind 'change:unbind(m)' <<< "$list") || exit 0

# --expect で 1行目に押されたキー（Enter なら空行）、2行目に選択行が来る。
key="${selected%%$'\n'*}"
line="${selected#*$'\n'}"
pane_id="${line##*$'\t'}"
[ -n "$pane_id" ] || exit 0

# 自分のペインは一覧に載せていないが、念のため選ばれても何もしない。attach
# すると自分の端末を自分の上に出して入力が自分に返る形になり、サイズも縮む。
current=$(awk -F'\t' '$5 == "1" { print $1; exit }' <<< "$panes")
for me in "${HERDR_ACTIVE_PANE_ID:-}" "${HERDR_PANE_ID:-}" "$current"; do
  [ -n "$me" ] && [ "$pane_id" = "$me" ] && exit 0
done

if [ "$key" != "ctrl-o" ]; then
  # 寄り道: この popup の中に端末を attach する。exec なので popup は開いた
  # まま、C-q m の detach で閉じる。
  exec ~/.local/bin/herdr-pane-attach "$pane_id"
fi

# フォーカスは CLI ではなく socket API を直接叩く。`herdr pane focus` は
# --direction 専用で、ペイン ID を渡す形が CLI に存在せず、渡すと usage を
# 出して exit 2 で黙って失敗する。API の pane.focus は pane_id を受け取る。
python3 - "$pane_id" <<'JUMP'
import json, os, socket, sys

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(os.path.expanduser("~/.config/herdr/herdr.sock"))
try:
    s.sendall((json.dumps({"id": "jump", "method": "pane.focus",
                           "params": {"pane_id": sys.argv[1]}}) + "\n").encode())
    s.makefile("r").readline()
finally:
    s.close()
JUMP
