#!/usr/bin/env python3
"""Run a shell in a Herdr popup; Ctrl-Q m closes the popup."""

import errno
import fcntl
import os
import pty
import select
import signal
import sys
import termios
import tty

PREFIX = 0x11  # Ctrl-Q, matching Herdr's configured prefix
DETACH = ord("m")


def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def main():
    if not os.isatty(0):
        print("herdr-popup-shell: a terminal is required", file=sys.stderr)
        return 1

    child, master = pty.fork()
    if child == 0:
        shell = os.environ.get("SHELL") or "/bin/sh"
        os.execvp(shell, [shell])

    saved = termios.tcgetattr(0)
    resized = [True]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    pending_prefix = False
    try:
        tty.setraw(0)
        while True:
            if resized[0]:
                resized[0] = False
                size = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
                fcntl.ioctl(master, termios.TIOCSWINSZ, size)

            try:
                readable, _, _ = select.select([0, master], [], [], 0.2)
            except InterruptedError:
                continue

            if master in readable:
                try:
                    output = os.read(master, 65536)
                except OSError as exc:
                    if exc.errno != errno.EIO:
                        raise
                    break
                if not output:
                    break
                write_all(1, output)

            if 0 in readable:
                input_bytes = os.read(0, 4096)
                if not input_bytes:
                    break
                forwarded = bytearray()
                close = False
                for byte in input_bytes:
                    if pending_prefix:
                        pending_prefix = False
                        if byte == DETACH:
                            close = True
                            break
                        if byte != PREFIX:
                            forwarded.append(PREFIX)
                        forwarded.append(byte)
                    elif byte == PREFIX:
                        pending_prefix = True
                    else:
                        forwarded.append(byte)
                if forwarded:
                    write_all(master, forwarded)
                if close:
                    break
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, saved)
        try:
            if os.waitpid(child, os.WNOHANG)[0] == 0:
                os.killpg(child, signal.SIGHUP)
        except (ChildProcessError, ProcessLookupError):
            pass
        os.close(master)
    return 0


if __name__ == "__main__":
    sys.exit(main())
