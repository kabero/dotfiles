#!/bin/bash
# ghq repo launcher for herdr — counterpart of tmux-session-selector (C-g).
# Lists ghq repos (+ chezmoi), marks the ones already open as a
# herdr workspace with a blue dot, and on selection focuses that workspace or
# creates one at the repo directory. Bound to bare C-g via [[keys.command]] in
# ~/.config/herdr/config.toml (same key as the tmux session selector);
# herdr's built-in goto lives on prefix+g.
# Typing <user>/<name> that doesn't exist yet offers a "[new project]" entry:
# enter runs `ghq create` (mkdir + git init under github.com/) and opens a
# workspace there; adding a remote origin is left to the user.

set -u

# Fetch Herdr workspaces while ghq scans repositories; both are independent.
ws_file=$(mktemp)
list_file=$(mktemp)
trap 'rm -f "$ws_file" "$list_file"' EXIT
herdr workspace list > "$ws_file" 2>/dev/null &
ws_pid=$!
ghq_root="$(ghq root)"

# Build repo list: ghq repos + chezmoi, plus initialized submodules.
# Read .gitmodules paths and check for a checkout's .git marker. `git submodule
# status --recursive` walks every submodule's repository and makes opening the
# picker slow on machines with many submodules.
list_submodules() {
  local dir=$1 relative=$2 entry path child
  [ -f "$dir/.gitmodules" ] || return 0
  while IFS= read -r -d '' entry; do
    path=${entry#*$'\n'}
    case "$path" in ''|.|..|/*|../*|*/../*|*/..|./*|*/./*|*/.) continue ;; esac
    child="$dir/$path"
    [ -e "$child/.git" ] || continue
    printf '%s/%s\n' "$relative" "$path"
    list_submodules "$child" "$relative/$path"
  done < <(git config --null --file "$dir/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null)
}
repo_list=$(ghq list)
submodules=$(while IFS= read -r r; do
  list_submodules "$ghq_root/$r" "$r"
done <<< "$repo_list")
[ -n "$submodules" ] && repo_list="$repo_list"$'\n'"$submodules"
repo_list="$repo_list
chezmoi"

# Workspace label = basename (including submodules).
label_of() {
  case "$1" in
    chezmoi) echo chezmoi ;;
    *) echo "${1##*/}" ;;
  esac
}

# Existing herdr workspaces: label \t id
wait "$ws_pid" || :
ws_tsv=$(jq -r '.result.workspaces[] | [.label, .workspace_id] | @tsv' \
  < "$ws_file" 2>/dev/null)

# Render: open workspaces first (blue dot, bright), rest dimmed, in one awk
# pass (a per-repo bash loop forks several processes per repo and gets slow).
# The canonical repo path rides along as a hidden TSV field (fzf shows field 1
# only); the visible path omits a leading host such as github.com/. Workspace
# labels come in via the environment to sidestep awk's
# empty-first-file NR==FNR pitfall.
WS_LABELS="$(printf '%s\n' "$ws_tsv" | cut -f1)" awk -F/ '
  BEGIN {
    n = split(ENVIRON["WS_LABELS"], l, "\n")
    for (i = 1; i <= n; i++) if (l[i] != "") open[l[i]] = 1
  }
  !NF { next }
  {
    repo = $0
    label = (repo == "chezmoi") ? "chezmoi" : $NF
    display = repo
    slash = index(display, "/")
    if (slash && substr(display, 1, slash - 1) ~ /\./)
      display = substr(display, slash + 1)
    if (label in open)
      printf "\033[38;5;75m●\033[0m  \033[1;38;5;255m%s\033[0m\t%s\n", display, repo
    else
      closed[++c] = sprintf("   \033[38;5;250m%s\033[0m\t%s", display, repo)
  }
  END { for (i = 1; i <= c; i++) print closed[i] }
' <<< "$repo_list" > "$list_file"

# On every keystroke, re-emit the list and — when the query looks like
# <user>/<name> and no such repo exists under github.com/ yet — append a
# "[new project]" entry (hidden field NEW:<user>/<name>). Selecting it
# creates the repo via `ghq create` below. {q} is shell-quoted by fzf.
export _HRS_LIST="$list_file" _HRS_ROOT="$ghq_root"
reload='q={q}; cat "$_HRS_LIST"; case "$q" in */*) case "$q" in */*/*|/*|*/|*[!A-Za-z0-9._/-]*) ;; *) if [ ! -e "$_HRS_ROOT/github.com/$q" ]; then printf "\033[38;5;114m+\033[0m  \033[38;5;114m[new project] %s\033[0m\tNEW:%s\n" "$q" "$q"; fi ;; esac ;; esac'

selected=$(fzf --ansi --height 100% --layout reverse \
      --border rounded --border-label " repo (herdr) " \
      --color "fg:-1,bg:-1,fg+:255,bg+:236,hl:75,hl+:75,pointer:75,marker:75,border:238,label:75,prompt:75,info:243,header:243,gutter:-1,spinner:75" \
      --pointer "▌" --prompt "> " \
      --bind "change:reload:$reload" \
      --delimiter='\t' --with-nth=1 --highlight-line < "$list_file") || exit 0

repo="${selected##*$'\t'}"
if [[ "$repo" == NEW:* ]]; then
  new="${repo#NEW:}"
  ghq create "$new" >/dev/null || exit 1   # fails if it already exists
  repo="github.com/$new"
fi
label=$(label_of "$repo")
if [ "$repo" = chezmoi ]; then
  dir="$HOME/.local/share/chezmoi"
else
  dir="$ghq_root/$repo"
fi

ws_id=$(printf '%s\n' "$ws_tsv" | awk -F'\t' -v l="$label" '$1 == l { print $2; exit }')
if [ -n "$ws_id" ]; then
  herdr workspace focus "$ws_id" >/dev/null
else
  herdr workspace create --cwd "$dir" --label "$label" --focus >/dev/null
fi
