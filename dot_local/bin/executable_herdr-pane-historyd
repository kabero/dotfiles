#!/usr/bin/env python3
"""herdr のエージェントペインへの「入力」を記録する常駐プロセス。

herdr の socket API には入力イベントが存在しない（購読可能な26種のどれも
入力を表さない。PaneInfo.revision も出力変化に追従しないので代用にならない）。
そこで入力の検知は2経路に分ける:

  シェルペイン    zsh の preexec フック → 直接 pane-history.tsv に追記（dot_zshrc）
  エージェントペイン  このデーモン → agent_status が working に落ちた瞬間を拾う

エージェントが working に入るのはプロンプトを投げられた時だけなので、
「フォーカス中のペインが working へ遷移した」= 人間がそこに入力した、と読める。
フォーカスで絞るのは、他のエージェントが API 経由で起こした working を
履歴に混ぜないため。

状態の取得元は pane.agent_status_changed。pane_id 必須で全ペインをまとめて
購読できないので、起動時の全ペイン分を1接続に束ね、pane.created が来たら
接続を張り直して新しいペインを含める（閉じたペインの購読は放置でよい）。
以前は pane.updated（引数なしで全ペイン分が流れ、PaneInfo に agent_status が
入る）から差分を取っていたが、herdr 0.9.0 で pane.updated は端末タイトル
（スピナーを除いた部分）が変わった時にしか流れなくなり、遷移を取りこぼす
ようになった。
イベントの封筒は2種類あり、ライフサイクル系は "pane_focused" のように
下線、購読系（agent_status_changed）は "pane.agent_status_changed" のように
ドット区切りで来る。どちらも event と data を持つ。

herdr-pane-history がこのファイルを読んで MRU ピッカーを出す。
"""

import errno
import json
import os
import socket
import sys
import time

STATE = os.path.expanduser("~/.local/state/herdr")
HIST = os.path.join(STATE, "pane-history.tsv")
PIDFILE = os.path.join(STATE, "pane-historyd.pid")
SOCK = os.environ.get("HERDR_SOCK", os.path.expanduser("~/.config/herdr/herdr.sock"))

# 追記のみのファイルなので、上限を超えたら新しい方だけ残して書き直す。
MAX_LINES = 2000
KEEP_LINES = 1000
# 同じペインを続けて記録しない間隔。
DEBOUNCE_SEC = 20.0


def claim_pidfile():
    """多重起動を防ぐ。生きている先客がいれば False。"""
    os.makedirs(STATE, exist_ok=True)
    while True:
        try:
            fd = os.open(PIDFILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except OSError as e:
            if e.errno != errno.EEXIST:
                raise
            try:
                with open(PIDFILE) as f:
                    old = int(f.read().strip())
            except (ValueError, OSError):
                old = None
            if old is not None:
                try:
                    os.kill(old, 0)
                    return False          # 先客が生きている
                except OSError:
                    pass                  # 死んでいる → 奪う
            try:
                os.unlink(PIDFILE)
            except OSError:
                pass
            continue
        with os.fdopen(fd, "w") as f:
            f.write(str(os.getpid()))
        return True


def prune():
    try:
        with open(HIST) as f:
            lines = f.readlines()
    except OSError:
        return
    if len(lines) <= MAX_LINES:
        return
    tmp = HIST + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(lines[-KEEP_LINES:])
    os.replace(tmp, HIST)


def append(pane_id, kind, detail):
    detail = detail.replace("\t", " ").replace("\n", " ")[:120]
    line = "%d\t%s\t%s\t%s\n" % (int(time.time()), pane_id, kind, detail)
    # PIPE_BUF 未満の追記は不可分なので、各ペインの zsh フックと競合しない。
    with open(HIST, "a") as f:
        f.write(line)


def request(method, params=None):
    """1接続1リクエスト（購読ストリームだけが例外）。"""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    try:
        s.sendall((json.dumps({"id": "hist", "method": method,
                               "params": params or {}}) + "\n").encode())
        return json.loads(s.makefile("r").readline())
    finally:
        s.close()


def seed_state():
    """購読開始前のフォーカスと各ペインの状態を埋めておく。

    これがないと、接続直後に届く最初の pane.updated が軒並み「遷移」に
    見えて、実行中のエージェントが片っ端から履歴に載る。
    """
    try:
        panes = request("pane.list")["result"]["panes"]
    except Exception:
        return None, {}
    focused = None
    status = {}
    for p in panes:
        status[p["pane_id"]] = p.get("agent_status")
        if p.get("focused"):
            focused = p["pane_id"]
    return focused, status


def pane_id_of(data):
    """イベント data からペイン ID を取る。直下の pane_id か、pane.pane_id。"""
    pid = data.get("pane_id")
    if not pid and isinstance(data.get("pane"), dict):
        pid = data["pane"].get("pane_id")
    return pid


class Tracker:
    """イベントを食べて履歴に追記する。接続をまたいで debounce を持ち越す。"""

    def __init__(self, focused, status, last=None, now=time.time, record=append):
        self.focused = focused
        self.status = status
        self.last = last if last is not None else {}   # pane_id -> 最後に記録した時刻
        self.now = now
        self.record = record
        self.n = 0

    def handle(self, ev):
        """1イベント処理。新しいペインが増えて張り直しが要るなら True。"""
        kind = (ev.get("event") or "").replace(".", "_")
        data = ev.get("data") or {}

        if kind == "pane_focused":
            self.focused = pane_id_of(data) or self.focused
        elif kind == "pane_created":
            pid = pane_id_of(data)
            if pid:
                self.status.setdefault(pid, None)
            return True
        elif kind == "pane_closed":
            self.status.pop(pane_id_of(data), None)
        elif kind == "pane_agent_status_changed":
            pid = pane_id_of(data)
            if not pid:
                return False
            new_status = data.get("agent_status")
            prev = self.status.get(pid)
            self.status[pid] = new_status
            # working への「遷移」だけを見る。
            if new_status != "working" or prev == "working" or pid != self.focused:
                return False
            # 1ターンの中でも working↔idle は何度か振れるので、ペインごとに
            # 間引く。欲しいのは MRU の順序であって入力の全件記録ではない。
            now = self.now()
            if now - self.last.get(pid, 0.0) < DEBOUNCE_SEC:
                return False
            self.record(pid, "agent", data.get("agent") or "agent")
            self.last[pid] = now
            self.n += 1
            if self.n % 50 == 0:
                prune()
        return False


def run_once(last):
    focused, status = seed_state()
    subs = [{"type": "pane.focused"},
            {"type": "pane.created"},
            {"type": "pane.closed"}]
    subs += [{"type": "pane.agent_status_changed", "pane_id": pid} for pid in status]

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.sendall((json.dumps({"id": "hist", "method": "events.subscribe",
                           "params": {"subscriptions": subs}}) + "\n").encode())
    tracker = Tracker(focused, status, last)
    try:
        for raw in s.makefile("r"):
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            if tracker.handle(ev):
                return          # ペインが増えた → 張り直し
    finally:
        s.close()


def main():
    if not claim_pidfile():
        return 0
    os.makedirs(STATE, exist_ok=True)
    prune()
    last = {}
    try:
        while True:
            try:
                run_once(last)
                # 正常に戻った = pane.created で張り直し。すぐ繋ぎ直す。
                continue
            except Exception:
                pass
            # herdr サーバー再起動時はソケットが落ちるので、待って張り直す。
            time.sleep(3)
    finally:
        try:
            with open(PIDFILE) as f:
                if int(f.read().strip()) == os.getpid():
                    os.unlink(PIDFILE)
        except (OSError, ValueError):
            pass


if __name__ == "__main__":
    sys.exit(main())
