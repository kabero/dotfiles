          },
          { "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [{ "matcher": "", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }] }],
    "PermissionRequest": [{ "matcher": "", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }] }],
    "Notification": [{ "matcher": "", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }] }],
    "SessionStart": [{ "matcher": "", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }] }],
    "SessionEnd": [{ "matcher": "", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-herdr-act", "timeout": 5 }] }]
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
CHEZMOI_DESIRED_JSON
)

# Deep-merge the owned keys over the live file, then rebuild hooks per event:
# our entries first, then live entries that are not ours (herdr's, anyone's).
program='
  . as $in
  | ($in * ($d | del(.hooks)))
  | .hooks = (
      $d.hooks as $mine
      | (($in.hooks) // {}) as $live
      | reduce ((($mine | keys_unsorted) + ($live | keys_unsorted)) | unique)[] as $k
          ({}; .[$k] = (($mine[$k] // []) + (($live[$k] // []) - ($mine[$k] // []))))
    )
'

if jq -e --argjson d "$desired" "($program) == ." "$cur" >/dev/null 2>&1; then
  cat "$cur"
else
  jq --argjson d "$desired" "$program" "$cur"
fi
