#!/usr/bin/env python3
"""各ペインに、所属スペースの色番号トークン $s<n> を報告する。

  startup            : 全ペイン
  pane.created/moved : そのペイン
  workspace.renamed  : そのスペースのペイン全部
  workspace.updated  : 同上（ラベルが変わっていなければ何もしない）

トークンは s0..s<N-1> のうち 1 つだけ値（= スペース名）を持ち、残りは null で
消す。値が既に合っているペインは書かない（workspace.updated は頻繁に来る）。
番号は ~/.local/bin/herdr-space-color が決める（prefix+m と同じ関数）。
イベントの JSON は HERDR_PLUGIN_EVENT_JSON。socket は HERDR_SOCKET_PATH。
"""

import json
import os
import socket
import subprocess
import sys

SOURCE = "kabe.space-color"
HELPER = os.path.expanduser("~/.local/bin/herdr-space-color")
SOCK = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")


def call(method, params):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    try:
        s.sendall((json.dumps({"id": "sc", "method": method, "params": params}) + "\n").encode())
        return json.loads(s.makefile("r").readline()).get("result") or {}
    finally:
        s.close()


def palette_size():
    out = subprocess.run([HELPER, "--palette"], capture_output=True, text=True, check=True).stdout
    return len([l for l in out.splitlines() if l])


def buckets(labels):
    labels = sorted(set(l for l in labels if l))
    if not labels:
        return {}
    out = subprocess.run([HELPER, *labels], capture_output=True, text=True, check=True).stdout
    m = {}
    for line in out.splitlines():
        f = line.split("\t", 3)
        if len(f) == 4:
            m[f[3]] = int(f[0])
    return m


def apply(panes):
    """panes: pane.list 形式の dict の列。"""
    ws = {w["workspace_id"]: (w.get("label") or "")
          for w in call("workspace.list", {}).get("workspaces", [])}
    n = palette_size()
    idx = buckets(ws.values())
    for p in panes:
        label = ws.get(p.get("workspace_id"), "")
        if not label or label not in idx:
            continue
        key = "s%d" % idx[label]
        if (p.get("tokens") or {}).get(key) == label and \
                not any(k in (p.get("tokens") or {}) for k in ("s%d" % i for i in range(n)) if k != key):
            continue
        tokens = {"s%d" % i: None for i in range(n)}
        tokens[key] = label
        call("pane.report_metadata",
             {"pane_id": p["pane_id"], "source": SOURCE, "tokens": tokens})


def main():
    raw = os.environ.get("HERDR_PLUGIN_EVENT_JSON") or ""
    try:
        ev = json.loads(raw) if raw else {}
    except ValueError:
        ev = {}
    data = ev.get("data") if isinstance(ev.get("data"), dict) else ev
    kind = str(data.get("type") or ev.get("event") or "").replace(".", "_")

    if kind in ("pane_created", "pane_moved") and isinstance(data.get("pane"), dict):
        apply([data["pane"]])
        return 0

    panes = call("pane.list", {}).get("panes", [])
    if kind in ("workspace_renamed", "workspace_updated"):
        wid = data.get("workspace_id") or (data.get("workspace") or {}).get("workspace_id")
        panes = [p for p in panes if p.get("workspace_id") == wid]
    apply(panes)          # startup / 手動実行 / 上記以外 = 全ペイン
    return 0


if __name__ == "__main__":
    sys.exit(main())
